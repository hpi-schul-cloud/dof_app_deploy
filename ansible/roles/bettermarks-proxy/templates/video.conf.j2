apiVersion: v1
kind: ConfigMap
metadata:
  name: bettermarks-{{ item }}-proxy-nginx-server-block
  namespace: {{ BETTERMARKS_PROXY_NAMESPACE }}
  labels:
    app.kubernetes.io/instance: bettermarks-{{ item }}-proxy
    app.kubernetes.io/name: bettermarks-proxy
  annotations:
data:
  server-block.conf: |
    server{
      listen 8080;
      location / {
        # Configuration for eventsource
        proxy_buffering off;
        proxy_cache off;
        gzip off;
        proxy_hide_header 'Access-Control-Allow-Origin';
        add_header 'Access-Control-Allow-Origin' $http_origin always;
        # Hide original CSP Headers
        proxy_hide_header 'Content-Security-Policy';
        proxy_hide_header 'Content-Security-Policy-Report-Only';
        add_header 'Content-Security-Policy' "default-src 'self' 'unsafe-eval' 'unsafe-inline' data: *.{{ DOMAIN }} *.{{ BETTERMARKSPROXY_DOMAIN }} *.{{ bettermarks_instance_domain }} {{ bettermarks_instance_domain }}; report-uri https://{{ bettermarks_proxy_subdomains['csp-report'] }}{{ BETTERMARKS_PROXY_SEPARATOR }}{{ DOMAIN }}/csp" always;
        proxy_set_header {{ proxy_identification_header }} true;
        proxy_pass https://{{ bettermarks_target_domain }};
        proxy_ssl_server_name on;
        proxy_intercept_errors off;
        # Turn off gzip so that we can perform regex replacement
        proxy_set_header Accept-Encoding "";
        # Search for ORIGIN and replace with HOST
        sub_filter {{ bettermarks_target_domain }} {{ bettermarks_instance_domain }};
        sub_filter .{{ bettermarks_domain }} .{{ BETTERMARKSPROXY_DOMAIN }};    sub_filter_types text/html;
        sub_filter_once off;
      }
    }
