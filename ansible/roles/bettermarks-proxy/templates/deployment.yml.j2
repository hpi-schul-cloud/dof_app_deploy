apiVersion: apps/v1
kind: Deployment
metadata:
  labels:
    app.kubernetes.io/instance: bettermarks-{{ item }}-proxy
    app.kubernetes.io/name: nginx
  annotations:
    meta.helm.sh/release-name: bettermarks-{{ item }}-proxy
    meta.helm.sh/release-namespace: {{ NAMESPACE }}
spec:
  replicas: 1
  selector:
    matchLabels:
      app.kubernetes.io/instance: bettermarks-{{ item }}-proxy
      app.kubernetes.io/name: nginx
  template:
    metadata:
      labels:
        app.kubernetes.io/instance: bettermarks-{{ item }}-proxy
        app.kubernetes.io/name: nginx
    spec:
      volumes:
      - name: nginx-server-block
        configMap:
          name: bettermarks-{{ item }}-proxy-nginx-server-block
          defaultMode: 420
      containers:
      - name: nginx
        image: {{ bettermarks_proxy_image }}
        ports:
        - name: http
          containerPort: 8080
          protocol: TCP
        env:
        - name: NGINX_HTTP_PORT_NUMBER
          value: "8080"
        resources:
          limits:
            cpu: "1"
            memory: 1Gi
          requests:
            cpu: 100m
            memory: 100Mi
        volumeMounts:
        - name: nginx-server-block
          mountPath: /opt/bitnami/nginx/conf/server_blocks
        livenessProbe:
          tcpSocket:
            port: http
          initialDelaySeconds: 30
          timeoutSeconds: 5
          periodSeconds: 10
          successThreshold: 1
          failureThreshold: 6
        readinessProbe:
          tcpSocket:
            port: http
          initialDelaySeconds: 5
          timeoutSeconds: 3
          periodSeconds: 5
          successThreshold: 1
          failureThreshold: 3
        terminationMessagePath: /dev/termination-log
        terminationMessagePolicy: File
        imagePullPolicy: IfNotPresent
        securityContext:
          runAsUser: 1001
          runAsNonRoot: true
      restartPolicy: Always
      terminationGracePeriodSeconds: 30
      dnsPolicy: ClusterFirst
      automountServiceAccountToken: false
      shareProcessNamespace: false
      securityContext: {}
      imagePullSecrets:
      - name: docker-token
      affinity:
        podAntiAffinity:
          preferredDuringSchedulingIgnoredDuringExecution:
          - weight: 1
            podAffinityTerm:
              labelSelector:
                matchLabels:
                  app.kubernetes.io/instance: bettermarks-{{ item }}-proxy
                  app.kubernetes.io/name: nginx
              topologyKey: kubernetes.io/hostname
      schedulerName: default-scheduler
  strategy:
    type: RollingUpdate
    rollingUpdate:
      maxUnavailable: 25%
      maxSurge: 25%
  revisionHistoryLimit: 10
  progressDeadlineSeconds: 600
