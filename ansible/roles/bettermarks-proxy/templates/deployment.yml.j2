apiVersion: apps/v1
kind: Deployment
metadata:
  labels:
    app.kubernetes.io/instance: bettermarks-{{ item }}-proxy
    app.kubernetes.io/name: nginx
    app.kubernetes.io/part-of: schulcloud-verbund
    app.kubernetes.io/managed-by: ansible
{% if ANNOTATIONS is defined and ANNOTATIONS|bool %}
  annotations:
    meta.helm.sh/release-name: bettermarks-{{ item }}-proxy
    meta.helm.sh/release-namespace: {{ NAMESPACE }}
{% if RELOADER is defined and RELOADER|bool %}
    reloader.stakater.com/auto: "true"
{% endif %}
{% endif %}    
spec:
  replicas: 1
  selector:
    matchLabels:
      app.kubernetes.io/instance: bettermarks-{{ item }}-proxy
      app.kubernetes.io/name: nginx
  template:
    metadata:
      labels:
        app.kubernetes.io/instance: bettermarks-{{ item }}-proxy
        app.kubernetes.io/name: nginx
        app.kubernetes.io/version: "{{ BETTERMARKS_PROXY_IMAGE_TAG }}"
        app.kubernetes.io/part-of: schulcloud-verbund
        app.kubernetes.io/managed-by: ansible
    spec:
      volumes:
      - name: nginx-server-block
        configMap:
          name: bettermarks-{{ item }}-proxy-nginx-server-block
          defaultMode: 420
      containers:
      - name: nginx
        image: {{ BETTERMARKS_PROXY_IMAGE_NAME }}:{{ BETTERMARKS_PROXY_IMAGE_TAG }}
        ports:
        - name: http
          containerPort: 8080
          protocol: TCP
        env:
        - name: NGINX_HTTP_PORT_NUMBER
          value: "8080"
        resources:
          limits:
            cpu: {{ BETTERMARKS_PROXY_CPU_LIMITS|default("1000m", true) }}
            memory: {{ BETTERMARKS_PROXY_MEMORY_LIMITS|default("1Gi", true) }}
          requests:
            cpu: {{ BETTERMARKS_PROXY_CPU_REQUESTS|default("100m", true) }}
            memory: {{ BETTERMARKS_PROXY_MEMORY_REQUESTS|default("100Mi", true) }}
        volumeMounts:
        - mountPath: /etc/nginx/conf.d/default.conf
          name: nginx-server-block
          subPath: server-block.conf

        livenessProbe:
          tcpSocket:
            port: http
          initialDelaySeconds: 30
          timeoutSeconds: 5
          periodSeconds: 10
          successThreshold: 1
          failureThreshold: 6
        readinessProbe:
          tcpSocket:
            port: http
          initialDelaySeconds: 5
          timeoutSeconds: 3
          periodSeconds: 5
          successThreshold: 1
          failureThreshold: 3
        terminationMessagePath: /dev/termination-log
        terminationMessagePolicy: File
        imagePullPolicy: IfNotPresent
        securityContext:
          runAsUser: 1001
          runAsNonRoot: true
      restartPolicy: Always
      terminationGracePeriodSeconds: 30
      dnsPolicy: ClusterFirst
      automountServiceAccountToken: false
      shareProcessNamespace: false
      securityContext: {}
      imagePullSecrets:
      - name: docker-token
{% if AFFINITY_ENABLE is defined and AFFINITY_ENABLE|bool %}
      affinity:
        podAffinity:
          preferredDuringSchedulingIgnoredDuringExecution:
          - weight: 9
            podAffinityTerm:
              labelSelector:
                matchExpressions:
                - key: app.kubernetes.io/part-of
                  operator: In
                  values:
                  - schulcloud-verbund
              topologyKey: "kubernetes.io/hostname"
              namespaceSelector: {}
        podAntiAffinity:
          preferredDuringSchedulingIgnoredDuringExecution:
{% if ANIT_AFFINITY_NODEPOOL_ENABLE is defined and ANIT_AFFINITY_NODEPOOL_ENABLE|bool %}
          - weight: 10
            podAffinityTerm:
              labelSelector:
                matchLabels:
                  app.kubernetes.io/instance: bettermarks-{{ item }}-proxy
              topologyKey: {{ ANIT_AFFINITY_NODEPOOL_TOPOLOGY_KEY }}
{% endif %}
          - weight: 20
            podAffinityTerm:
              labelSelector:
                matchLabels:
                  app.kubernetes.io/instance: bettermarks-{{ item }}-proxy
              topologyKey: "topology.kubernetes.io/zone"
{% endif %}
      schedulerName: default-scheduler
  strategy:
    type: RollingUpdate
    rollingUpdate:
      maxUnavailable: 25%
      maxSurge: 25%
  revisionHistoryLimit: 10
  progressDeadlineSeconds: 600
