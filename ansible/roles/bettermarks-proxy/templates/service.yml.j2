apiVersion: v1
kind: Service
metadata:
  name: bettermarks-{{ item }}-proxy-nginx
  namespace: {{ BETTERMARKS_PROXY_NAMESPACE }}
  labels:
    app.kubernetes.io/instance: bettermarks-{{ item }}-proxy
    app.kubernetes.io/name: bettermarks-proxy
spec:
  ports:
  - name: http
    protocol: TCP
    port: 80
    targetPort: http
  selector:
    app.kubernetes.io/instance: bettermarks-{{ item }}-proxy
  type: ClusterIP