apiVersion: v1
kind: Service
metadata:
  name: bettermarks-{{ item }}-proxy-nginx
  namespace: {{ NAMESPACE }}
  labels:
    app.kubernetes.io/instance: bettermarks-{{ item }}-proxy
    app.kubernetes.io/name: nginx
  annotations:
status:
  loadBalancer: {}
spec:
  ports:
  - name: http
    protocol: TCP
    port: 80
    targetPort: http
  selector:
    app.kubernetes.io/instance: bettermarks-{{ item }}-proxy
    app.kubernetes.io/name: nginx
  type: ClusterIP
  sessionAffinity: None
  ipFamilies:
  - IPv4
  ipFamilyPolicy: SingleStack
  internalTrafficPolicy: Cluster