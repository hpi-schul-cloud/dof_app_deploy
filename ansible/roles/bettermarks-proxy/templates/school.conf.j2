apiVersion: v1
kind: ConfigMap
metadata:
  name: bettermarks-{{ item }}-proxy-nginx-server-block
  namespace: {{ NAMESPACE }}
  labels:
    app.kubernetes.io/instance: bettermarks-{{ item }}-proxy
    app.kubernetes.io/name: nginx
  annotations:
data:
  server-block.conf: |
    server{
        listen 8080;
        location /app/free-betty/content/content_exercises {
            # Configuration for eventsource
            proxy_buffering off;
            proxy_cache off;
            gzip off;
            # Hide original header first.
            proxy_hide_header 'Access-Control-Allow-Origin';
            # Re-add the header with calling origin.
            add_header 'Access-Control-Allow-Origin' $http_origin always;
            proxy_hide_header 'Access-Control-Allow-Credentials';
            add_header 'Access-Control-Allow-Credentials' true always;
            # Hide original CSP Headers
            proxy_hide_header 'Content-Security-Policy';
            proxy_hide_header 'Content-Security-Policy-Report-Only';
        {% if bettermarks_proxy_csp_enabled and bettermarks_proxy_csp_enforced %}
            add_header 'Content-Security-Policy' "default-src 'self' 'unsafe-eval' 'unsafe-inline' data: *.{{ DOMAIN }} *.{{ bettermarks_instance_domain }} {{ bettermarks_instance_domain }}; report-uri https://{{ bettermarks_proxy_subdomains['csp-report'] }}{{ BETTERMARKS_PROXY_SEPARATOR }}{{ DOMAIN }}/csp" always;
        {% elif bettermarks_proxy_csp_enabled %}
            add_header 'Content-Security-Policy-Report-Only' "default-src 'self' 'unsafe-eval' 'unsafe-inline' data: *.{{ DOMAIN }} *.{{ bettermarks_instance_domain }} {{ bettermarks_instance_domain }}; report-uri https://{{ bettermarks_proxy_subdomains['csp-report'] }}{{ BETTERMARKS_PROXY_SEPARATOR }}{{ DOMAIN }}/csp/report-only" always;
        {% endif %}
            # Proxy to the origin
            proxy_set_header {{ proxy_identification_header }} true;
            proxy_pass https://{{ bettermarks_target_domain }};
            proxy_ssl_server_name on;
            # Override the cookie domain
            proxy_cookie_domain .{{ bettermarks_domain }} .{{ DOMAIN }};
            # Turn off gzip so that we can perform regex replacement
            proxy_set_header Accept-Encoding "";
            # Search for ORIGIN and replace with HOST
            sub_filter media.{{ bettermarks_domain }} {{ bettermarks_target_domain }}/app/free-betty;
            sub_filter_once off;
            sub_filter_types text/html;
        }
        location /config/user {
            # Configuration for eventsource
            proxy_buffering off;
            proxy_cache off;
            gzip off;
            # Hide original header first.
            proxy_hide_header 'Access-Control-Allow-Origin';
            # Re-add the header with calling origin.
            add_header 'Access-Control-Allow-Origin' $http_origin always;
            proxy_hide_header 'Access-Control-Allow-Credentials';
            add_header 'Access-Control-Allow-Credentials' true always;
            # Hide original CSP Headers
            proxy_hide_header 'Content-Security-Policy';
            proxy_hide_header 'Content-Security-Policy-Report-Only';
        {% if bettermarks_proxy_csp_enabled and bettermarks_proxy_csp_enforced %}
            add_header 'Content-Security-Policy' "default-src 'self' 'unsafe-eval' 'unsafe-inline' data: *.{{ DOMAIN }} *.{{ bettermarks_instance_domain }} {{ bettermarks_instance_domain }}; report-uri https://{{ bettermarks_proxy_subdomains['csp-report'] }}{{ BETTERMARKS_PROXY_SEPARATOR }}{{ DOMAIN }}/csp" always;
        {% elif bettermarks_proxy_csp_enabled %}
            add_header 'Content-Security-Policy-Report-Only' "default-src 'self' 'unsafe-eval' 'unsafe-inline' data: *.{{ DOMAIN }} *.{{ bettermarks_instance_domain }} {{ bettermarks_instance_domain }}; report-uri https://{{ bettermarks_proxy_subdomains['csp-report'] }}{{ BETTERMARKS_PROXY_SEPARATOR }}{{ DOMAIN }}/csp/report-only" always;
        {% endif %}
            proxy_set_header {{ proxy_identification_header }} true;
            proxy_pass https://{{ bettermarks_target_domain }};
            proxy_ssl_server_name on;
            proxy_intercept_errors off;
            # Override the cookie domain
            proxy_cookie_domain .{{ bettermarks_domain }} .{{ DOMAIN }};
            # Turn off gzip so that we can perform regex replacement
            proxy_set_header Accept-Encoding "";
            # Search for ORIGIN and replace with HOST
            sub_filter {{ bettermarks_target_domain }} {{ bettermarks_instancedomain }};
            sub_filter .{{ bettermarks_domain }} .{{ DOMAIN }};
            sub_filter_once off;
            sub_filter_types application/json;
        }
        location / {
            # Configuration for eventsource
            proxy_buffering off;
            proxy_cache off;
            gzip off;
            # Hide original header first.
            proxy_hide_header 'Access-Control-Allow-Origin';
            # Re-add the header with calling origin.
            add_header 'Access-Control-Allow-Origin' $http_origin always;
            proxy_hide_header 'Access-Control-Allow-Credentials';
            add_header 'Access-Control-Allow-Credentials' true always;
            # Hide original CSP Headers
            proxy_hide_header 'Content-Security-Policy';
            proxy_hide_header 'Content-Security-Policy-Report-Only';
        {% if bettermarks_proxy_csp_enabled and bettermarks_proxy_csp_enforced %}
            add_header 'Content-Security-Policy' "default-src 'self' 'unsafe-eval' 'unsafe-inline' data: *.{{ DOMAIN }} *.{{ bettermarks_instance_domain }} {{ bettermarks_instance_domain }}; report-uri https://{{ bettermarks_proxy_subdomains['csp-report'] }}{{ BETTERMARKS_PROXY_SEPARATOR }}{{ DOMAIN }}/csp" always;
        {% elif bettermarks_proxy_csp_enabled %}
            add_header 'Content-Security-Policy-Report-Only' "default-src 'self' 'unsafe-eval' 'unsafe-inline' data: *.{{ DOMAIN }} *.{{ bettermarks_instance_domain }} {{ bettermarks_instance_domain }}; report-uri https://{{ bettermarks_proxy_subdomains['csp-report'] }}{{ BETTERMARKS_PROXY_SEPARATOR }}{{ DOMAIN }}/csp/report-only" always;
        {% endif %}
            # Proxy to the origin
            proxy_set_header {{ proxy_identification_header }} true;
            proxy_pass https://{{ bettermarks_target_domain }};
            proxy_ssl_server_name on;
            proxy_intercept_errors off;
            # Override the cookie domain
            proxy_cookie_domain .{{ bettermarks_domain }} .{{ DOMAIN }};
            # Turn off gzip so that we can perform regex replacement
            proxy_set_header Accept-Encoding "";
            # Search for ORIGIN and replace with HOST
            sub_filter {{ bettermarks_target_domain }} {{ bettermarks_instance_domain }};
            sub_filter .{{ bettermarks_domain }} .{{ DOMAIN }};
            sub_filter_once off;
            sub_filter_types application/json;
        }
    }
