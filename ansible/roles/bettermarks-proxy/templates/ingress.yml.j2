apiVersion: networking.k8s.io/v1
kind: Ingress
metadata:
  name: bettermarks-{{ item }}-proxy-nginx
  namespace: {{ NAMESPACE }}
  labels:
    app.kubernetes.io/instance: bettermarks-{{ item }}-proxy
    app.kubernetes.io/name: nginx
  annotations:
{% if CLUSTER_ISSUER is defined %}
    cert-manager.io/cluster-issuer: {{ CLUSTER_ISSUER }}
{% endif %}

spec:
  ingressClassName: {{ INGRESS_CLASS }}
{% if CLUSTER_ISSUER is defined or (TLS_ENABLED is defined and TLS_ENABLED|bool) %}
  tls:
  - hosts: 
      - {{ bettermarks_instance_domain }}
{% if CLUSTER_ISSUER is defined %}
    secretName: {{ bettermarks_instance_domain }}-tls
{% endif %}
{% endif %}
  rules:
  - host: {{ bettermarks_instance_domain }}
    http:
      paths:
      - path: /
        pathType: ImplementationSpecific
        backend:
          service:
            name: bettermarks-{{ item }}-proxy-nginx
            port:
              name: http
