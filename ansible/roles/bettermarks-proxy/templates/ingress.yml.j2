apiVersion: networking.k8s.io/v1
kind: Ingress
metadata:
  name: bettermarks-{{ item }}-proxy-nginx
  namespace: {{ NAMESPACE }}
  labels:
    app.kubernetes.io/instance: bettermarks-{{ item }}-proxy
    app.kubernetes.io/name: nginx
  annotations:
    cert-manager.io/cluster-issuer: sc-cert-manager-clusterissuer-letsencrypt
spec:
  ingressClassName: nginx
  tls:
  - hosts:
    - {{ item }}.{{ bettermarks_proxy_maindomain }}
    secretName: {{ item }}.{{ bettermarks_proxy_maindomain }}-tls
  rules:
  - host: {{ item }}.{{ bettermarks_proxy_maindomain }}
    http:
      paths:
      - path: /
        pathType: ImplementationSpecific
        backend:
          service:
            name: bettermarks-{{ item }}-proxy-nginx
            port:
              name: http
