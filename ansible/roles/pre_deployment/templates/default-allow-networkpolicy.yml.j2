apiVersion: networking.k8s.io/v1
kind: NetworkPolicy
metadata:
  name: pre-deployment-default-allow
  namespace: {{ NAMESPACE }}
spec:
  podSelector:
    matchLabels:
      app: deployment-metrics-marker
  policyTypes:
    - Ingress
  ingress:
    - from:
        - namespaceSelector:
            matchExpressions:
              - key: kubernetes.io/metadata.name
                operator: In
                values:
                  - monitoring
                  - ingress-controller
                  - scaling
                  - "{{ NAMESPACE }}"
