apiVersion: networking.k8s.io/v1
kind: NetworkPolicy
metadata:
  name: session-valkey-default-allow
  namespace: {{ NAMESPACE }}
spec:
  podSelector:
    matchExpressions:
      - key: app.kubernetes.io/instance
        operator: In
        values:
          - session
  policyTypes:
    - Ingress
  ingress:
    - from:
        - namespaceSelector:
            matchExpressions:
              - key: kubernetes.io/metadata.name
                operator: In
                values:
                  - monitoring
                  - ingress-controller
                  - scaling
                  - "{{ NAMESPACE }}"
