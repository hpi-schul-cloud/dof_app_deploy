---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: storage-seaweedfs-deployment
  namespace: {{ NAMESPACE }}
{% if ANNOTATIONS is defined and ANNOTATIONS|bool %}
  annotations:
{% if RELOADER is defined and RELOADER|bool %}
    reloader.stakater.com/auto: "true"
{% endif %}
{% endif %}
  labels:
    app: storage
    app.kubernetes.io/part-of: schulcloud-verbund
    app.kubernetes.io/name: seaweedfs
    app.kubernetes.io/component: storage
    app.kubernetes.io/managed-by: ansible
    git.branch: {{ DOF_APP_DEPLOY_BRANCH_NAME }}
    git.repo: {{ DOF_APP_DEPLOY_REPO_NAME }}
spec:
  replicas: 1
  strategy:
    type: Recreate
  revisionHistoryLimit: 4
  paused: false
  selector:
    matchLabels:
      app: storage
  template:
    metadata:
      labels:
        app: storage
        app.kubernetes.io/part-of: schulcloud-verbund
        app.kubernetes.io/name: seaweedfs
        app.kubernetes.io/component: storage
        app.kubernetes.io/managed-by: ansible
        git.repo: {{ DOF_APP_DEPLOY_REPO_NAME }}
      annotations:
        configmapHash: ""
    spec:
      securityContext:
        runAsUser: 1000
        runAsGroup: 1000
        fsGroup: 1000
        runAsNonRoot: true
      os:
        name: linux
      containers:
      - name: storage
        image: {{ STORAGE_IMAGE_NAME }}
        imagePullPolicy: Always
        command: ["/bin/sh", "-ec"]
        args:
        - |
          export AWS_ACCESS_KEY_ID="${MINIO_ROOT_USER:-${MINIO_ACCESS_KEY:-}}"
          export AWS_SECRET_ACCESS_KEY="${MINIO_ROOT_PASSWORD:-${MINIO_SECRET_KEY:-}}"
          : "${AWS_ACCESS_KEY_ID:?storage-secret must contain MINIO_ROOT_USER or MINIO_ACCESS_KEY}"
          : "${AWS_SECRET_ACCESS_KEY:?storage-secret must contain MINIO_ROOT_PASSWORD or MINIO_SECRET_KEY}"
          exec weed mini -dir=/data -s3.port=9000
        ports:
        - containerPort: 9000
          name: storage
          protocol: TCP
        startupProbe:
          tcpSocket:
            port: storage
          periodSeconds: 5
          failureThreshold: 60
        readinessProbe:
          tcpSocket:
            port: storage
          periodSeconds: 10
        envFrom:
        - secretRef:
            name: storage-secret
        volumeMounts:
        - name: storage-pv
          mountPath: /data
          readOnly: false
        resources:
          limits:
            cpu: {{ STORAGE_CPU_LIMITS|default("1000m", true) }}
            memory: {{ STORAGE_MEMORY_LIMITS|default("1Gi", true) }}
          requests:
            cpu: {{ STORAGE_CPU_REQUESTS|default("100m", true) }}
            memory: {{ STORAGE_MEMORY_REQUESTS|default("128Mi", true) }}
      volumes:
      - name: storage-pv
        persistentVolumeClaim:
          claimName: storage-seaweedfs-pvc
