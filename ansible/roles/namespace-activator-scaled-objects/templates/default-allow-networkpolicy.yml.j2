apiVersion: networking.k8s.io/v1
kind: NetworkPolicy
metadata:
  name: namespace-activator-scaled-objects-default-allow
  namespace: {{ NAMESPACE }}
spec:
  podSelector:
    matchLabels:
      app.kubernetes.io/name: namespace-activator-redirection
  policyTypes:
    - Ingress
  ingress:
    - from:
        - namespaceSelector:
            matchLabels:
              kubernetes.io/metadata.name: ingress-controller
      ports:
        - port: 3100
          protocol: TCP
