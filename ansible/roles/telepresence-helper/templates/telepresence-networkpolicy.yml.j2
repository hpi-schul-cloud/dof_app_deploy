apiVersion: networking.k8s.io/v1
kind: NetworkPolicy
metadata:
  name: telepresence-helper
  namespace: {{ NAMESPACE }}
spec:
  # Telepresence may intercept any workload in a development namespace.
  podSelector: {}
  policyTypes:
    - Ingress
  ingress:
    - from:
        - namespaceSelector:
            matchLabels:
              kubernetes.io/metadata.name: ambassador
