apiVersion: networking.k8s.io/v1
kind: NetworkPolicy
metadata:
  name: allow-certmanager-acme
  namespace: {{ NAMESPACE }}
spec:
  policyTypes:
  - Ingress
  podSelector:
    matchExpressions:
      - key: acme.cert-manager.io/http-domain
        operator: Exists
      - key: acme.cert-manager.io/http-token
        operator: Exists
  ingress:
    - from:
      - namespaceSelector:
          matchExpressions:
            - key: kubernetes.io/metadata.name
              operator: In
              values:
                - ingress-controller